# node.env - launch flags for c2pool-v37-xmr (read by run-node.sh).
# install.sh copies this file to <data-dir>/node.env. Edit that copy.
# Each flag has its own ARGS line: comment a line out to drop the flag.
# Values in <angle brackets> are placeholders you must replace.
# This file is sourced by bash: keep one `ARGS="$ARGS ..."` per line.

ARGS=""

# ---- network -------------------------------------------------------------
# stagenet | testnet | regtest. Mainnet runs follow-only (RUN-A-NODE.md section 11).
ARGS="$ARGS --network stagenet"

# ---- the pool: every node of one pool uses the SAME identity -------------
# The embedded node builds the template (no monerod).
ARGS="$ARGS --xmr-template-source native"
# The embedded node is the tip and sends found blocks over levin. No monerod RPC.
ARGS="$ARGS --arm-order p2p-first"
# The pool identity from the pool's operator: <H>:<hash64>:<headline>, no
# spaces in this file. Nodes with another identity refuse each other.
ARGS="$ARGS --pool-genesis-from <POOL_IDENTITY>"
# Or a raw genesis with its height (test networks): <hex64>:<H>.
#ARGS="$ARGS --pool-genesis <POOL_GENESIS_64_HEX>:<H>"
# The pool's first node only: build templates with no Path B peer.
#ARGS="$ARGS --pathb-launch"
# RandomX proof-of-work verification (the pool node needs it).
ARGS="$ARGS --randomx"

# ---- payouts and fees ----------------------------------------------------
# The payee of the in-process miner's jobs. MAIN (standard) address only:
# starts with 5 on stagenet.
ARGS="$ARGS --payout-address <YOUR_MAIN_ADDRESS>"
# The author's weight share in this node's jobs, in percent. 0 opts out.
ARGS="$ARGS --give-author-pct 0.1"
# Optional: the node owner's weight share in this node's jobs, in percent,
# and its MAIN address.
#ARGS="$ARGS --node-owner-fee-pct 1"
#ARGS="$ARGS --node-owner-address <OWNER_MAIN_ADDRESS>"

# ---- relay: links to the other pool nodes --------------------------------
# Accept relay connections from other pool nodes (open this port to them).
ARGS="$ARGS --relay-listen 0.0.0.0:<RELAY_PORT>"
# Dial the pool's public nodes. Repeat for more peers.
ARGS="$ARGS --relay-peer <PUBLIC_NODE_1_HOST:PORT>"
ARGS="$ARGS --relay-peer <PUBLIC_NODE_2_HOST:PORT>"

# ---- Monero network (levin) ----------------------------------------------
# A levin peer you trust (your own monerod if you have one; 38080 stagenet,
# 18080 mainnet). Repeat for more. Or use --native-seeds.
#ARGS="$ARGS --native-connect <IP:38080>"
ARGS="$ARGS --native-seeds"
# On a slow link, give the anchor check (gate 4) more time.
#ARGS="$ARGS --anchor-confirm-timeout-ms 180000"

# ---- snapshot and state (relative paths are under the data dir) ----------
# The pinned output-set file (see RUN-A-NODE.md). Its sha256 is checked at boot.
ARGS="$ARGS --native-output-set xmr_stagenet_output_set.bin"
# Saves the chain index here so a restart resumes.
ARGS="$ARGS --native-snapshot-path native.snap"
# The Path B store. Never delete it between restarts.
ARGS="$ARGS --data-dir pathb"

# ---- miners (stratum) ----------------------------------------------------
# 127.0.0.1 if the miners run on this machine, 0.0.0.0 to serve the LAN.
ARGS="$ARGS --stratum-bind-host 0.0.0.0"
ARGS="$ARGS --stratum-port 3333"

# ---- dashboard -----------------------------------------------------------
# http://<web-host>:<web-port>/ ; 127.0.0.1 keeps it local.
ARGS="$ARGS --web-port 8080"
ARGS="$ARGS --web-host 127.0.0.1"

# ---- log -----------------------------------------------------------------
# Seconds between status blocks in the log.
ARGS="$ARGS --status-every 30"

# ---- in-process mining (off by default) ----------------------------------
# Mine the node's own template with N threads. Needs --randomx.
#ARGS="$ARGS --mine 2"

# ---- run-node.sh / memguard settings (not node flags) --------------------
# memguard stops the node cleanly when MemAvailable falls below this (MB).
MEMGUARD_MIN_MB=1024
# MEMGUARD=off
