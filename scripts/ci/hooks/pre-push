#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# pre-push hook: run the attribution gate over every pushed ref (the new
# commit messages, their author and committer, the branch name and the lines
# the pushed commits add) and refuse the push on any marker from
# ci/attribution-patterns.txt or ci/attribution-identity-patterns.txt. Install
# in a clone with
#   git config core.hooksPath scripts/ci/hooks
set -uo pipefail
export LC_ALL=C.UTF-8
root=$(git rev-parse --show-toplevel)
gate=$root/scripts/ci/attribution_gate.sh
pats=$root/ci/attribution-patterns.txt
if [ ! -f "$gate" ] || [ ! -s "$pats" ]; then
    echo "pre-push: attribution gate or pattern file missing; push refused"
    exit 1
fi
zero=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha rref rsha; do
    [ "$lsha" = "$zero" ] && continue                       # a deletion carries no content
    if [ "$rsha" = "$zero" ]; then
        range="$lsha --not --remotes"
        base=$(git merge-base "$lsha" refs/remotes/origin/master 2>/dev/null || true)
    else
        range="$rsha..$lsha"
        base=$rsha
    fi
    diff=""
    [ -n "$base" ] && diff="$base $lsha"
    echo "pre-push: attribution gate for ${rref#refs/heads/} ($range)"
    GATE_RANGE="$range" GATE_DIFF="$diff" GATE_PATTERNS="$pats" BRANCH="${rref#refs/heads/}" \
        bash "$gate" || rc=1
done
[ "$rc" -ne 0 ] && echo "pre-push: push refused"
exit $rc
